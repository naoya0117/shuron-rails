Rails.application.configure do
  # Kubernetes-layer configuration for Kubernetes-focused runtime behavior.
  # Keep health checks and future Kubernetes-specific settings in this one file.
  config.x.kubernetes = {
    liveness: {
      path: "/kubernetes/health/live"
    },
    readiness: {
      path: "/kubernetes/health/ready",
      check_database: true,
      timeout_ms: Integer(ENV.fetch("KC_READINESS_TIMEOUT_MS", "300"))
    }
  }
end
