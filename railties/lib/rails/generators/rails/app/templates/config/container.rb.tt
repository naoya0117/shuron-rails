Rails.application.configure do
  # Container-layer configuration for container-focused runtime behavior.
  # Keep health checks and future container/Kubernetes settings in this one file.
  config.x.container = {
    liveness: {
      path: "/container/health/live"
    },
    readiness: {
      path: "/container/health/ready",
      check_database: true,
      timeout_ms: Integer(ENV.fetch("CONTAINER_READINESS_TIMEOUT_MS", "300"))
    },
    resources: {
      # CPU: request のみ設定。limits は設定しない（throttling 防止・Burstable QoS）
      cpu: { request: "100m" },
      # Memory: request == limit に設定（Guaranteed QoS でメモリ不足時の強制停止を防ぐ）
      memory: { request: "256Mi", limit: "256Mi" }
    },
    graceful_shutdown: {
      # preStop で sleep する秒数。Service endpoint 削除の伝搬待ち
      pre_stop_delay: "15s",
      # terminationGracePeriodSeconds。SIGTERM〜SIGKILL の全体タイムアウト
      grace_period: "60s"
    },
    process_containment: {
      # 生成マニフェストに注入する securityContext（Process Containment）。
      # secure by default: そもそも root で動かさない方が、後から降格するより堅い。
      # kubelet が起動前に強制するため、アプリ内降格より強い防御線になる。
      run_as_non_root: true,
      allow_privilege_escalation: false,
      drop_capabilities: ["ALL"]
      # read_only_root_filesystem: true  # opt-in: ルートFSに書かないイメージ前提
      # run_as_user: 1000                # 任意: 実行 UID を固定
      # enabled: false                   # securityContext 注入をまるごと無効化
    }
  }
end

# Register graceful shutdown hooks (optional). Hooks run as the process
# terminates, which covers SIGTERM from the orchestrator.
#
# Release resources this process holds -- nothing else. Hooks must be idempotent
# and free of business side effects, because at_exit fires in *every* Ruby
# process: a container that runs `rails db:prepare` and `rails container:init`
# before starting its server runs them three times, twice while the app is
# still booting. Work that must happen exactly once when the Pod stops belongs
# in the preStop hook (generated from graceful_shutdown below); business logic
# belongs in an init step, which runs once, before traffic, idempotently.
#
# Rails::Container::GracefulShutdown.on_shutdown do
#   ActiveRecord::Base.connection_handler.clear_all_connections!
# end

# Process Containment. The container layer warns whenever the process runs as
# root -- on every platform, since running as root is a property of the image
# (run `bin/rails container:doctor` to see the pending diagnostics). The layer
# only reports it; enforcement is the platform's, via the securityContext
# generated from these settings and applied by the kubelet before the process
# starts. Fix it in the image (a USER line) and declare the posture here:
#
#   process_containment: {
#     run_as_user:                1000,
#     run_as_non_root:            true,
#     allow_privilege_escalation: false,
#     drop_capabilities:          ["ALL"]
#   }
