Rails.application.configure do
  # Container-layer configuration for Kubernetes-focused runtime behavior.
  # Keep health checks and future container-specific settings in this one file.
  config.x.kubernetes_container = {
    endpoints: {
      liveness_path: "/container/health/live",
      readiness_path: "/container/health/ready"
    },
    liveness: {
      # If set, this path is preferred over endpoints.liveness_path.
      path: "/container/health/live"
    },
    readiness: {
      # If set, this path is preferred over endpoints.readiness_path.
      path: "/container/health/ready",
      check_database: true,
      timeout_ms: Integer(ENV.fetch("KC_READINESS_TIMEOUT_MS", "300"))
    }
  }
end
